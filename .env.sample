# ── Voitta Desktop ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.

# ── Ports ──────────────────────────────────────────────────────────────────
LLM_PROXY_PORT=18900
MCP_PROXY_PORT=18765
GOOGLE_MCP_PORT=18766
JIRA_MCP_PORT=18767
OAUTH_REDIRECT_PORT=53214

# ── Microsoft (Entra ID / Azure AD) ───────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# ── Google OAuth2 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Jira ──────────────────────────────────────────────────────────────────
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=

# ── MCP subprocess paths ─────────────────────────────────────────────────
GOOGLE_MCP_DIR=~/DEVEL/google_workspace_mcp
GOOGLE_MCP_ENV_PATH=~/DEVEL/google_workspace_mcp/.env
JIRA_MCP_DIR=~/DEVEL/mcp-atlassian
JIRA_MCP_ENV_PATH=~/.voitta_desktop/jira.env

# ── RAG backend ───────────────────────────────────────────────────────────
VOITTA_RAG_URL=https://rag.voitta.ai
